{
  "name": "_sample",
  "version": "0.1.0",
  "display_name": "Sample Runtime Pack",
  "description": "Execution tests for plugin tools.",
  "module": "marvis.packs._sample.tools",
  "tools": [
    {
      "name": "echo",
      "summary": "Return the supplied message.",
      "input_schema": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "echoed": {
            "type": "string"
          }
        },
        "required": [
          "echoed"
        ],
        "additionalProperties": false
      },
      "determinism": "deterministic",
      "timeout_seconds": 10,
      "failure_policy": "fail",
      "entrypoint": "tool_echo",
      "side_effects": []
    },
    {
      "name": "fail",
      "summary": "Raise an error to test failure handling.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      },
      "determinism": "deterministic",
      "timeout_seconds": 10,
      "failure_policy": "fail",
      "entrypoint": "tool_fail",
      "side_effects": []
    },
    {
      "name": "bad_output",
      "summary": "Return an invalid result to test schema validation.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "echoed": {
            "type": "string"
          }
        },
        "required": [
          "echoed"
        ],
        "additionalProperties": false
      },
      "determinism": "deterministic",
      "timeout_seconds": 10,
      "failure_policy": "fail",
      "entrypoint": "tool_bad_output",
      "side_effects": []
    },
    {
      "name": "sleep",
      "summary": "Pause execution to test timeout handling.",
      "input_schema": {
        "type": "object",
        "properties": {
          "seconds": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "seconds"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "slept": {
            "type": "boolean"
          }
        },
        "required": [
          "slept"
        ],
        "additionalProperties": false
      },
      "determinism": "deterministic",
      "timeout_seconds": 1,
      "failure_policy": "fail",
      "entrypoint": "tool_sleep",
      "side_effects": []
    },
    {
      "name": "random",
      "summary": "Generate a seeded random value for execution tests.",
      "input_schema": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "seed": {
            "type": "integer"
          }
        },
        "required": [
          "key"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "value": {
            "type": "number"
          },
          "seed": {
            "type": "integer"
          }
        },
        "required": [
          "value",
          "seed"
        ],
        "additionalProperties": false
      },
      "determinism": "stochastic",
      "timeout_seconds": 10,
      "failure_policy": "fail",
      "entrypoint": "tool_random",
      "side_effects": []
    },
    {
      "name": "memory_hog",
      "summary": "Allocate memory to test resource monitoring.",
      "input_schema": {
        "type": "object",
        "properties": {
          "megabytes": {
            "type": "integer",
            "minimum": 1
          },
          "hold_seconds": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "megabytes"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "allocated_mb": {
            "type": "integer"
          }
        },
        "required": [
          "allocated_mb"
        ],
        "additionalProperties": false
      },
      "determinism": "deterministic",
      "timeout_seconds": 30,
      "failure_policy": "fail",
      "entrypoint": "tool_memory_hog",
      "side_effects": []
    }
  ],
  "hooks": [],
  "permissions": []
}
